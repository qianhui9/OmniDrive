+    traces=[dict(path=str(p),bytes=p.stat().st_size) for p in sorted(root.glob('*/pipeline_trace.json'))]
+    write(root/'traces/index.json',dict(traces=traces,note='Original Chrome traces kept in each run; not duplicated here.'))
+    long_name='long_stream_retry' if (root/'long_stream_retry').exists() else 'long_stream'
+    required=('single','multi','language_candidates',long_name,'budget_0','budget_128','stride_refresh')
+    statuses={r['run']:r['status'] for r in runs}
+    formal={name:bool((statuses.get(name) or {}).get('status')=='completed'
+        and (statuses.get(name) or {}).get('weights_unchanged') is True) for name in required}
+    controls=[json.loads(p.read_text()) for p in root.glob('*/lifecycle_probe/results.json')]
+    lifecycle=any(c.get('recovered_matches_fresh_native') is True
