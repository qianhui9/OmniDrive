+        and c.get('controlled_reuse_source',{}).get('actual_reused_cameras',0)>0 for c in controls)
+    test_file=root/'validation_results.json'
+    tests=json.loads(test_file.read_text()) if test_file.exists() else {}
+    gpu=tests.get('delivery_gpu_tests.log',{})
+    gpu_ok=bool(gpu.get('passed') and gpu.get('failed')==0 and gpu.get('errors')==0)
+    fig_file=root/'figures/manifest.json'
+    figs=json.loads(fig_file.read_text()) if fig_file.exists() else {}
+    figures_ok=all(figs.get('S'+str(i),{}).get('status')=='measured' for i in range(1,11))
+    write(root/'completion.json',dict(formal_runs=formal,controlled_lifecycle=lifecycle,
