@@ -0,0 +1,17 @@
+# 真实视觉桥接审计
+
+结论：投影区域接口的有界预训练检查通过；不存在 WorldAnchor 与原生 VLM token 的一一对应。正式部署资格未获认证。
+
+六相机经实际输入 metadata 顺序排列，RGB归一化、resize/crop与K同步更新，本轮处理后输入640×640。EVA/M2输出 `[1,6,1024,40,40]`，原生patch stride16，camera-major、随后row-major。M2复用的是前部窗口及近似全局残差，其后仍有当前视觉计算；不能把窗口复用当作最终LLM输入相等。
+
+`petr3d.extract_img_feat`将M2输出整理为上述网格，Object/Map Head先投影1024→256并结合当前相机几何与历史时序状态。`streampetr_head.py:533–562`把256额外学习查询放在检测查询之前，额外query的reference/query_pos置零，检测框来自去掉额外查询后的分支。最终256个额外输出投影至4096，再追加1个CANbus/ego token。`petr_head_map.py:404–430`同样把256额外查询与1800个lane查询分开，lane由control points表达，额外map输出不构成道路栅格。Native视觉顺序固定为object256、ego1、map256，即 `[1,513,4096]`，LLM扩展时转其计算dtype。Head输出含当前ego/历史变换和全局上下文，通常跨帧不同。
+
+M1通过`omnidrive_adapter.outputs_from_model`把当前检测的ego坐标gravity center/corners经ego_to_world转换为世界框，按类别/大小/距离合法门加一次全局分配关联。普通关联不等于物理身份认证。`state_manager.py:519–528`将整份backbone/object_carrier/map_carrier来源绑定到多个anchor，`associated_feature_ids`没有token级归属或框索引映射。每个anchor的observation support则保存真实相机时间、投影xyxy区域和RGB描述子；描述子也不是前景mask。
+
+新增`worldstream/m3/visual_feature_bridge.py`只读当前提交的M1对象与已有EVA/M2网格。用已校验的camera-time外参、预处理K重新投影选中框的8角，取投影凸包内原生网格中心；按padding前真实image bounds裁剪，并排除其他当前对象support AABB，选择剩余位置最多的相机。无需新编码器、检测器或tracker。读取的是实际观测区域的上下文化特征，既非独立纯对象特征，也不宣称不含背景/全局影响。其他框排除保守，不构成遮挡/前景证明。
+
+160帧/5个日志的富集诊断产生262个合格身份观测，233个可提取区域；29个因支持不足拒绝。独立离线GT只在提取完成后评分，233/233可评分，222/233=95.2790%区域满足“至少80%网格中心落在对应GT 3D框投影凸包”，通过预设95%门；137次相邻身份延续正确。11个几何失败例保存在`bridge_analysis.json`，最差支持率50%。GT框投影包含背景，95%门是区域适用性预检，并非95%真实前景纯度；两个开发日志中一个仅有2个区域且1个失败，不外推单日志保证。
+
+原始网格位置中位数52，K64/128/256分别仅95/34/10个区域有足够位置。独立自然24帧中6个合格对象区域均只有15个位置。旧car Core资格没有自动授予64个真实视觉观测的资格。
+
+生成帧字段表示当前M2输出的读取帧，不表示该张量的每个上游窗口都首次在此帧计算；本轮未额外导出每个EVA输出位置的完整M2计算谱系。内容hash绑定实际读取的张量。所有新增桥接代码保持研究接口，未写入正式detector路径。
diff --git a/outputs/m3_world_visual_memory_run01/world_visual_memory_design.md b/outputs/m3_world_visual_memory_run01/world_visual_memory_design.md
new file mode 100644
index 00000000..fa0e2874
--- /dev/null
+++ b/outputs/m3_world_visual_memory_run01/world_visual_memory_design.md
@@ -0,0 +1,13 @@
+# 单个历史区域视觉记忆
+
+实现：`worldstream/m3/visual_memory.py`，一份VisualMemory与一个VisualMemoryManager。记录身份、类别、相机、读取帧、源几何状态版本、最新有效观测、age、revision、scope、真实特征及内容hash。身份仅作生命周期key，投影层只接收实际1024维特征；同类不同对象可以不同。
+
+本轮选择每个memory token对应一个不同原生网格观测，K64/128/256只作有限预算诊断；少于K个位置拒绝，不做补零、复制或把类别复制成K个token。多于K时按原始row-major位置等距下采样成K个。该选择是本轮最小路线的约束，不是所有可学习resampler的信息论下界。
+
+当前帧首次满足身份与区域条件才创建，后续每帧同时重验当前身份资格和区域支持。保持直接返回相同feature tensor与相同projected embedding tensor，未重新生成近似前缀。新对象、类变化、缺失支持、超过8帧、时间断裂、state回滚及scene/epoch/model/adapter/memory/qualification版本变化撤销或重建；revision防止偶然相同内容继承已撤销的视觉KV。修改保存tensor会fail closed。
+
+历史EVA区域仍含旧的外观、位置和背景。本实现承诺其为固定历史上下文，不承诺当前外观不变。位置/速度/朝向/灯态/新对象必须由完整当前513个Native tokens提供，不从旧框或velocity生成稳定语义。语义/运动质量尚未通过训练后LLM测试，不能据此部署。
+
+唯一具体候选布局为 `[P, historical K, current native513, Q]`，无memory直接返回原Native tensor，指针/dtype/顺序不变。投影为单个1024→4096 Linear，测试参数未训练，仅用于实际张量保持和计算成本；不得加载为正式adapter。成本门NO_GO后未选主训练K、未压缩当前视觉、未扩展M3Runtime正式布局。
+
+成本控制直接调用既有PrefixKVCache/PrefixMatcher/ReusePlanner/PrefillExecutor；没有新执行器。源KV由真实LLM forward产生，严格比较实际embedding/position/mask与live执行签名，stable_anchor元数据绑定合法memory scope与revision，动态suffix仍实际prefill。控制实验的显式reuse_length独立于scheduler准入；正式链路集成与scheduler成本表均未获准发布。撤销边界沿用既有matcher裁掉视觉前缀，单测覆盖偶然同值重建。
diff --git a/tests/worldstream_m3/test_visual_feature_bridge.py b/tests/worldstream_m3/test_visual_feature_bridge.py
new file mode 100644
index 00000000..4b9cd508
--- /dev/null
+++ b/tests/worldstream_m3/test_visual_feature_bridge.py
@@ -0,0 +1,70 @@
+from copy import deepcopy
+import numpy as np
+import pytest
+import torch
+
+from worldstream.m1 import CameraFrame, Frame, WorldAnchor
+from worldstream.m1.config import M1Config
+from worldstream.m1.geometry import box_geometry, project_anchor
+from worldstream.m1.state_types import AnchorObservation
+from worldstream.m3.visual_feature_bridge import inside_convex, projected_region_features
+
+
+def fixture():
+    cam = CameraFrame('front', np.zeros((96, 128, 3), np.uint8),
+        np.array([[80., 0, 64], [0, 80., 48], [0, 0, 1]]), np.eye(4), 1.)
+    frame = Frame('s', 'f', 1., np.eye(4), {'front': cam})
+    anchor = WorldAnchor('a', 's', 'object', 'car', box_geometry([0, 0, 10], [6, 6, 4]), 1., None)
+    anchor.source_frame_id = 'f'; anchor.state_version = 'v1'
+    cfg = M1Config(uncertainty_px=0, min_region_area_px=1)
+    p = project_anchor(anchor, cam, cfg)
+    assert p.valid
+    anchor.observation_support['front'] = AnchorObservation('front', p.region, np.ones(4), 1., 1.)
+    features = torch.arange(64.).reshape(1, 1, 1, 8, 8)
+    return frame, anchor, features, cfg
+
+
+def test_native_grid_geometry_padding_and_owned_gather():
+    frame, anchor, features, cfg = fixture()
+    regions, rejected = projected_region_features(frame, [anchor], features, cfg, camera_ids=['front'])
+    assert not rejected and len(regions) == 1
+    r = regions[0]
+    assert not r.foreground_certified and r.source_state_version == 'v1'
+    # Image is unpadded height 96, features cover padded 128. Never stretch y.
+    idx = np.asarray(r.grid_indices)
+    assert ((idx // 8+.5)*16 < 96).all()
+    assert torch.equal(r.features[:, 0], torch.as_tensor(idx).float())
+    old = r.features.clone(); features.fill_(-1)
+    assert torch.equal(old, r.features)
+
+
+def test_current_competing_projection_cannot_become_object_feature():
+    frame, anchor, features, cfg = fixture()
+    other = deepcopy(anchor); other.anchor_id = 'b'
+    regions, rejected = projected_region_features(frame, [anchor, other], features, cfg,
+        camera_ids=['front'], selected_ids=['a'])
+    assert not regions and rejected['a'] == 'insufficient_unambiguous_projected_grid_support'
+
+
+def test_stale_or_asynchronous_observation_rejected():
+    frame, anchor, features, cfg = fixture()
+    anchor.source_frame_id = 'old'
+    regions, rejected = projected_region_features(frame, [anchor], features, cfg, camera_ids=['front'])
+    assert not regions and rejected['a'] == 'not_current_committed_object'
+    anchor.source_frame_id = 'f'; frame.cameras['front'].timing_reliable = False
+    assert not projected_region_features(frame, [anchor], features, cfg, camera_ids=['front'])[0]
+
+
+def test_camera_order_and_patch_coverage_fail_closed():
+    frame, anchor, features, cfg = fixture()
+    with pytest.raises(ValueError, match='camera order'):
+        projected_region_features(frame, [anchor], features, cfg, camera_ids=['rear'])
+    with pytest.raises(ValueError, match='cover'):
+        projected_region_features(frame, [anchor], features[..., :3, :3], cfg, camera_ids=['front'])
+
+
+def test_hull_uses_projected_polygon_not_axis_aligned_box():
+    polygon = np.array([[0, 2], [2, 0], [4, 2], [2, 4]])
+    points = np.array([[2, 2], [0, 0], [2, 0]])
+    assert inside_convex(points, polygon).tolist() == [True, False, True]
+    assert np.array_equal(inside_convex(points, polygon), inside_convex(points, polygon[::-1]))
