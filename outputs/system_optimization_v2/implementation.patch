+"""Verify completed GPU artifacts after an independently recorded exit fault."""
+import hashlib,json
+from pathlib import Path
+from .audit import write
+from .v2_checks import rows,check
+
+
+def main():
+    root=Path('outputs/system_optimization_v2');verified={}
+    for name in ('single','multi','long_stream','stride_refresh','auto_validation'):
+        path=root/name;status=json.loads((path/'status.json').read_text());assert status['status']=='completed' and status['weights_unchanged']
+        protocol=json.loads((path/'protocol.json').read_text());args=protocol['args'];data=rows(path/'frames.jsonl')
+        expected=args['scenes']*args['frames']*len(args['modes'])*(args['warmup']+args['repeats'])
+        assert len(data)==expected and all(r['frame']['status']=='completed' for r in data)
+        if any(r['mode']=='m1' for r in data):assert check(path,required=False)['passed']
+        verified[name]=dict(expected_rows=expected,actual_rows=len(data),weights_unchanged=True,
+            frame_file_sha256=hashlib.sha256((path/'frames.jsonl').read_bytes()).hexdigest())
+    for name,key in [('formal_probes/overlap_lifecycle/results.json','passed'),
+            ('long_state_supply/state_supply_results.json','weights_unchanged')]:
+        record=json.loads((root/name).read_text());assert record[key] is True
+    backend=json.loads((root/'formal_probes/decode_backend_results.json').read_text())
+    assert len(backend['quality'])==4 and all(r['complete_token_equality'] and r['cpu_rng_equal'] and r['cuda_rng_equal'] for r in backend['quality'])
+    profiles=json.loads((root/'formal_probes/profile_manifest.json').read_text())
+    assert len(profiles)==3 and all(Path(r['path']).stat().st_size>0 for r in profiles)
+    batch=json.loads((root/'batch_probes/batch_quality_results.json').read_text())
+    assert all(batch['sampling_fallback']['complete_token_equality'])
+    write(root/'formal_process_failure.json',dict(process_exit_code=139,
+        phase='After the complete GPU stage marker; no native stack trace available',
+        user_reported_hardware_cause='Faulty physical CPU cores 4/5; subsequent execution uses taskset -c 0-3,6-31',
+        raw_compute_artifacts_eligible=True,eligibility_reason='All expected rows, weight checks, strict state gates, lifecycle controls and standalone probes exist and pass',
+        original_process_not_marked_successful=True,verified_runs=verified))
+    print('Verified complete GPU artifacts; preserve exit 139 separately and resume offline analysis')
+
+
+if __name__=='__main__':main()
diff --git a/worldstream/code_signature.py b/worldstream/code_signature.py
new file mode 100644
index 0000000..fb97d00
--- /dev/null
+++ b/worldstream/code_signature.py
@@ -0,0 +1,49 @@
+"""Content fingerprints independent of marshal's runtime reference flags."""
+from functools import lru_cache
+import hashlib,json,struct,types
+
+
+def _encoded(value):
+    if value is None:return ['none']
+    if value is Ellipsis:return ['ellipsis']
+    if isinstance(value,bool):return ['bool',value]
+    if isinstance(value,int):return ['int',str(value)]
+    if isinstance(value,float):return ['float64',struct.pack('>d',value).hex()]
+    if isinstance(value,complex):return ['complex128',struct.pack('>dd',value.real,value.imag).hex()]
+    if isinstance(value,str):return ['str',value]
+    if isinstance(value,bytes):return ['bytes',value.hex()]
+    if isinstance(value,types.CodeType):return ['code',_code(value)]
+    if isinstance(value,(tuple,list)):return [type(value).__name__,[_encoded(v) for v in value]]
+    if isinstance(value,frozenset):
+        items=[_encoded(v) for v in value];items.sort(key=_json);return ['frozenset',items]
+    if isinstance(value,dict):return ['dict',[[_encoded(k),_encoded(v)] for k,v in value.items()]]
+    # Offline module/forward probes can carry object defaults. Such wrappers
+    # deliberately get a local witness and cannot inherit portable native keys.
+    return ['nonportable_default',type(value).__module__,type(value).__qualname__,id(value)]
+
+
+def _json(value):return json.dumps(value,ensure_ascii=True,sort_keys=True,separators=(',',':'))
+
+
+def _code(code):
+    fields=('co_argcount','co_posonlyargcount','co_kwonlyargcount','co_nlocals','co_stacksize','co_flags',
+        'co_code','co_consts','co_names','co_varnames','co_freevars','co_cellvars','co_exceptiontable')
+    # Filenames/line tables do not change execution. Bytecode, literal values,
+    # variable binding and exception tables do; encode each by value, not ID.
+    return {name:_encoded(getattr(code,name,None)) for name in fields}
+
+
+@lru_cache(maxsize=4096)
+def stable_code_hash(code):
+    return hashlib.sha256(_json(['code-content-v1',_code(code)]).encode()).hexdigest()
+
+
+def stable_function_hash(function):
+    rows=[];seen=set();function=getattr(function,'__func__',function)
+    while function is not None and id(function) not in seen:
+        seen.add(id(function));actual=getattr(function,'__func__',function);code=getattr(actual,'__code__',None)
+        rows.append([getattr(actual,'__module__',type(actual).__module__),getattr(actual,'__qualname__',type(actual).__qualname__),
+            stable_code_hash(code) if code is not None else str(type(actual)),
+            _encoded(getattr(actual,'__defaults__',None)),_encoded(getattr(actual,'__kwdefaults__',None))])
+        function=getattr(actual,'__wrapped__',None)
+    return hashlib.sha256(_json(['function-content-v1',rows]).encode()).hexdigest()
